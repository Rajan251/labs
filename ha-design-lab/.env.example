# ============================================
# .env.example - Template for Environment Variables
# ============================================
# Copy this file to .env and update with your values
# ⚠️ NEVER commit .env files to version control
# ============================================

# ============================================
# MongoDB Connection Settings
# ============================================

# Full MongoDB connection string (RECOMMENDED)
# Format: mongodb://username:password@host1:port1,host2:port2,host3:port3/database?options
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/DATABASE?replicaSet=REPLICA_SET_NAME&authSource=AUTH_DB&w=majority&wtimeout=5000&readPreference=primary&maxPoolSize=100&minPoolSize=10&retryWrites=true

# OR use individual components (if your app builds the URI)
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_HOSTS=host1:27017,host2:27017,host3:27017
MONGODB_DATABASE=your_database
MONGODB_REPLICA_SET=rs0
MONGODB_AUTH_SOURCE=admin

# ============================================
# Connection Pool Settings
# ============================================
# Max number of connections per application instance
MONGODB_MAX_POOL_SIZE=100

# Min number of connections to keep alive
MONGODB_MIN_POOL_SIZE=10

# Max time a connection can be idle (milliseconds)
MONGODB_MAX_IDLE_TIME_MS=30000

# ============================================
# Write Concern Settings
# ============================================
# Options: 1 (fast, risky), "majority" (recommended), 2, 3 (safest)
MONGODB_WRITE_CONCERN=majority

# Timeout for write operations (milliseconds)
MONGODB_WRITE_TIMEOUT_MS=5000

# Wait for journal commit
MONGODB_JOURNAL=true

# ============================================
# Read Preference Settings
# ============================================
# Options: primary, primaryPreferred, secondary, secondaryPreferred, nearest
MONGODB_READ_PREFERENCE=primary

# Max acceptable staleness for secondary reads (seconds)
MONGODB_MAX_STALENESS_SECONDS=90

# ============================================
# Timeout Settings
# ============================================
# Server selection timeout (milliseconds)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Connection timeout (milliseconds)
MONGODB_CONNECT_TIMEOUT_MS=10000

# Socket timeout (milliseconds)
MONGODB_SOCKET_TIMEOUT_MS=10000

# ============================================
# Retry Settings
# ============================================
# Automatically retry failed writes
MONGODB_RETRY_WRITES=true

# Automatically retry failed reads
MONGODB_RETRY_READS=true

# ============================================
# TLS/SSL Settings
# ============================================
# Enable TLS/SSL encryption
MONGODB_TLS_ENABLED=false

# Path to CA certificate file
MONGODB_TLS_CA_FILE=/path/to/ca.pem

# Path to client certificate file
MONGODB_TLS_CERT_FILE=/path/to/client.pem

# Allow invalid certificates (ONLY for testing)
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false

# Allow invalid hostnames (ONLY for testing)
MONGODB_TLS_ALLOW_INVALID_HOSTNAMES=false

# ============================================
# Application Settings
# ============================================
APP_NAME=MyApplication
APP_ENV=development
APP_PORT=3000
APP_LOG_LEVEL=debug

# ============================================
# Additional Connection Strings
# ============================================

# Admin connection (for maintenance tasks)
MONGODB_ADMIN_URI=mongodb://admin:ADMIN_PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/admin?replicaSet=rs0

# Read-only connection (for analytics)
MONGODB_READONLY_URI=mongodb://readonly:READONLY_PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/DATABASE?replicaSet=rs0&readPreference=secondaryPreferred

# ============================================
# Monitoring & Alerting (Optional)
# ============================================
MONGODB_MONITORING_ENABLED=false
MONGODB_SLOW_QUERY_THRESHOLD_MS=100
ALERT_EMAIL=admin@example.com

# ============================================
# Backup Settings (Optional)
# ============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
